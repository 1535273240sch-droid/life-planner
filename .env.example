# 人生智能编排体 (Life Planner AI) 环境变量配置
# 使用方法：复制本文件为 .env，再按需修改。.env 不会被提交到 git。

# 服务运行配置
# 注意：start.py 实际绑定 0.0.0.0（同一 Wi-Fi 的设备都能访问），且服务没有任何登录保护。
APP_HOST=127.0.0.1
APP_PORT=8000
# 调试模式。服务对局域网可见，建议保持 False。
DEBUG=False

# 数据库配置 (默认为当前目录 SQLite)
DATABASE_URL=sqlite:///./life_planner.db

# 大模型 API 配置
# 任何兼容 OpenAI 协议的端点都行（OpenAI、DeepSeek、硅基流动、各类代理等）。
# 换服务商时，请同时修改下面三项：AI_API_KEY、AI_BASE_URL、AI_MODEL。
# 配置 Key 后，你的个人档案（含健康信息）、技能、目标和近 7 天日志会发送给该服务商，详见 README 隐私声明。
# AI_API_KEY 留空则所有 AI 功能会明确报错，不会用模板代替。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
