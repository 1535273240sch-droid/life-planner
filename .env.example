# 人生智能编排体 (Life Planner AI) 环境变量配置

# 服务运行配置
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# 数据库配置 (默认为当前目录 SQLite)
DATABASE_URL=sqlite:///./life_planner.db

# 大模型 API 配置 (支持兼容 OpenAI 协议的任何端点，如 DeepSeek, Claude 代理, OpenAI, 硅基流动等)
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 若暂未配置真实 API Key，系统将自动进入 Mock 模式，确保全链路演示不报错
AI_MOCK_FALLBACK=True
